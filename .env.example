# Configuração da instalação usada por docker/compose.yml (copie para .env).
# O DATABASE_URL é montado pelo compose a partir de POSTGRES_PASSWORD.
POSTGRES_PASSWORD=troque-esta-senha
SIM_MODE=all
SIM_MIGRATE_ON_START=true
# Endereço público do SIM (usado no retorno do SSO e para marcar cookies como Secure em HTTPS)
SIM_PUBLIC_URL=http://localhost:3000

# Atrás de proxy reverso (nginx, Traefik, load balancer): true, número de proxies ou lista de IPs.
# Necessário para o limite de tentativas de login enxergar o IP real de quem acessa.
SIM_TRUST_PROXY=false

# E-mail (opcional): sem SMTP_URL o SIM funciona normalmente, só não envia e-mails.
# O envio roda em segundo plano (Redis, já incluído no docker/compose.yml).
# Formato: smtp://usuario:senha@smtp.empresa.com.br:587 (smtps:// para TLS implícito)
SMTP_URL=
SIM_MAIL_FROM=SIM <sim@empresa.com.br>
# Idioma dos e-mails: pt-BR | en
SIM_LOCALE=pt-BR

# Conta de emergência: primeiro Administrador da instalação (senha com no mínimo 12 caracteres)
SIM_EMERGENCY_EMAIL=admin@empresa.com.br
SIM_EMERGENCY_PASSWORD=
# E-mails que entram como Administrador (separados por vírgula)
SIM_ADMIN_EMAILS=

# SSO (veja apps/api/.env.example para todas as opções): off | oidc | oauth2
# URL de retorno a cadastrar no provedor: <SIM_PUBLIC_URL>/api/auth/sso/callback
SIM_SSO_MODE=off
SIM_SSO_CLIENT_ID=
SIM_SSO_CLIENT_SECRET=
SIM_SSO_ISSUER=
# Restrição por grupo do provedor (opcional): só quem está em SIM_ACCESS_GROUP entra;
# quem está em SIM_ADMIN_GROUP é Administrador. A lista de grupos vem da claim SIM_SSO_CLAIM_GROUPS.
SIM_ACCESS_GROUP=
SIM_ADMIN_GROUP=
# Texto do botão de SSO; vazio mostra "Entrar com SSO" no idioma de quem acessa
SIM_SSO_BUTTON_LABEL=

# Desativa Colaboradores (exceto Administradores) sem login por tantos dias; vazio desliga
SIM_INACTIVITY_DAYS=

# Ideias Paradas: dias sem ação de um Avaliador (cada Categoria pode definir os seus)
SIM_STALLED_OPEN_DAYS=15
SIM_STALLED_REVIEW_DAYS=30
# Dias após o aviso aos Avaliadores até avisar os Administradores
SIM_STALLED_ESCALATION_DAYS=7

# Anexos: tamanho máximo por arquivo (MB) e quantidade por Ideia ou Comentário.
# Os arquivos ficam no volume /data do contêiner (veja docker/compose.yml).
SIM_ATTACHMENT_MAX_MB=10
SIM_ATTACHMENT_MAX_COUNT=5

# Busca semântica (opcional): acha Ideias parecidas pelo sentido, além das palavras.
# Qualquer serviço compatível com a API de embeddings da OpenAI. Exige REDIS_URL.
#   OpenAI: https://api.openai.com/v1 + text-embedding-3-small + SIM_EMBEDDINGS_API_KEY
#   Ollama: http://ollama:11434/v1 + nomic-embed-text (perfil "ollama" do compose)
SIM_EMBEDDINGS_URL=
SIM_EMBEDDINGS_MODEL=
SIM_EMBEDDINGS_API_KEY=
# Semelhança mínima (0 a 1); depende do modelo, ajuste olhando os resultados
SIM_SEMANTIC_THRESHOLD=0.75
