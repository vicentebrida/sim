# Configuração da instalação usada por docker/compose.yml (copie para .env).
# O DATABASE_URL é montado pelo compose a partir de POSTGRES_PASSWORD.
POSTGRES_PASSWORD=troque-esta-senha
SIM_MODE=all
SIM_MIGRATE_ON_START=true
# Endereço público do SIM (usado no retorno do SSO e para marcar cookies como Secure em HTTPS)
SIM_PUBLIC_URL=http://localhost:3000

# Atrás de proxy reverso (nginx, Traefik, load balancer): true, número de proxies ou lista de IPs.
# Necessário para o limite de tentativas de login enxergar o IP real de quem acessa.
SIM_TRUST_PROXY=false

# Conta de emergência: primeiro Administrador da instalação (senha com no mínimo 12 caracteres)
SIM_EMERGENCY_EMAIL=admin@empresa.com.br
SIM_EMERGENCY_PASSWORD=
# E-mails que entram como Administrador (separados por vírgula)
SIM_ADMIN_EMAILS=

# SSO (veja apps/api/.env.example para todas as opções): off | oidc | oauth2
SIM_SSO_MODE=off
SIM_SSO_CLIENT_ID=
SIM_SSO_CLIENT_SECRET=
SIM_SSO_ISSUER=
SIM_SSO_BUTTON_LABEL=Entrar com SSO
