# Modo de execução: api | worker | all
SIM_MODE=all
PORT=3000
# Endereço pelo qual as pessoas acessam o SIM. Em desenvolvimento com SSO, use o do Vite
# (http://localhost:5173), que repassa /api para a porta 3000.
SIM_PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://sim:sim@localhost:5432/sim
# Roda as migrations ao subir (desligue para rodar manualmente com `pnpm db:migrate`)
SIM_MIGRATE_ON_START=true

# Atrás de proxy reverso (nginx, Traefik, load balancer): true, número de proxies ou lista de IPs.
# Necessário para o limite de tentativas de login enxergar o IP real de quem acessa.
SIM_TRUST_PROXY=false

# Conta de emergência: primeiro Administrador e acesso garantido se o SSO falhar (mín. 12 caracteres)
SIM_EMERGENCY_EMAIL=admin@sim.local
SIM_EMERGENCY_PASSWORD=troque-esta-senha
# E-mails que entram como Administrador (separados por vírgula)
SIM_ADMIN_EMAILS=

# SSO: off | oidc | oauth2
# URL de retorno a cadastrar no provedor: <SIM_PUBLIC_URL>/api/auth/sso/callback
SIM_SSO_MODE=off
SIM_SSO_CLIENT_ID=
SIM_SSO_CLIENT_SECRET=
# Modo oidc: só a issuer URL (o resto vem do discovery)
SIM_SSO_ISSUER=
# Modo oauth2: endpoints e escopos informados manualmente
SIM_SSO_AUTHORIZATION_URL=
SIM_SSO_TOKEN_URL=
SIM_SSO_USERINFO_URL=
SIM_SSO_SCOPES=
# client_secret_basic | client_secret_post
SIM_SSO_TOKEN_AUTH_METHOD=client_secret_basic
# Mapeamento de campos do perfil (aceita caminhos aninhados, ex.: org.department)
SIM_SSO_CLAIM_ID=sub
SIM_SSO_CLAIM_EMAIL=email
SIM_SSO_CLAIM_NAME=name
SIM_SSO_CLAIM_DEPARTMENT=
SIM_SSO_CLAIM_PICTURE=picture
# Claim com os grupos do provedor (lista ou texto separado por vírgula/espaço)
SIM_SSO_CLAIM_GROUPS=groups
# Só membros deste grupo entram pelo SSO (vazio: todos que o provedor aceitar)
SIM_ACCESS_GROUP=
# Membros deste grupo são Administradores a cada login (vazio: só SIM_ADMIN_EMAILS promove)
SIM_ADMIN_GROUP=
# Texto do botão de SSO; vazio mostra "Entrar com SSO" no idioma de quem acessa
SIM_SSO_BUTTON_LABEL=

# Diretório com o build do frontend, servido em produção
SIM_WEB_DIST=

# Segundo plano e e-mail (opcional). SMTP_URL exige REDIS_URL.
REDIS_URL=
SMTP_URL=
SIM_MAIL_FROM=SIM <sim@empresa.com.br>
# Idioma dos e-mails: pt-BR | en
SIM_LOCALE=pt-BR
# Resumo diário por e-mail: hora (0-23) e fuso horário (IANA, ex.: America/Sao_Paulo)
SIM_DIGEST_HOUR=8
SIM_TIMEZONE=UTC

# Desativa Colaboradores (exceto Administradores) sem login por tantos dias; vazio desliga
SIM_INACTIVITY_DAYS=

# Ideias Paradas (precisa de REDIS_URL para a verificação horária)
SIM_STALLED_OPEN_DAYS=15
SIM_STALLED_REVIEW_DAYS=30
SIM_STALLED_ESCALATION_DAYS=7

# Anexos: pasta dos arquivos, tamanho máximo por arquivo (MB) e quantidade por item
SIM_DATA_DIR=./data
SIM_ATTACHMENT_MAX_MB=10
SIM_ATTACHMENT_MAX_COUNT=5

# Busca semântica (opcional): acha Ideias parecidas pelo sentido, além das palavras.
# Qualquer serviço compatível com a API de embeddings da OpenAI. Exige REDIS_URL.
#   OpenAI: https://api.openai.com/v1 + text-embedding-3-small + SIM_EMBEDDINGS_API_KEY
#   Ollama: http://ollama:11434/v1 + nomic-embed-text (perfil "ollama" do compose)
SIM_EMBEDDINGS_URL=
SIM_EMBEDDINGS_MODEL=
SIM_EMBEDDINGS_API_KEY=
# Semelhança mínima (0 a 1); depende do modelo, ajuste olhando os resultados
SIM_SEMANTIC_THRESHOLD=0.75
