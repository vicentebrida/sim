{
  "name": "@sim/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "nest build && node dist/generate-openapi.js ../../packages/api-client/openapi.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.3.17",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.1.7",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@sim/config": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "oauth2-mock-server": "^9.3.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
